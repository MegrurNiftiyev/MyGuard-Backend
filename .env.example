PORT=3001
NODE_ENV=development

# Firebase Admin Configuration
# Path to service account JSON file OR base64 JSON string
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_STORAGE_BUCKET=myguard-security.appspot.com

# Optional Python FastAPI URL (Mocked for now)
FASTAPI_ANALYSIS_URL=http://localhost:8000
