# Server Configuration
PORT=3001
NODE_ENV=production

# Firebase Admin Credentials
# Option 1: Path to local JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./mygurad-firebase-admin.json

# Option 2: Render Environment Variable (Paste full JSON as single line into Render Environment Variables)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"mygurad",...}

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=mygurad.firebasestorage.app

# Python FastAPI Microservice URL (FastAPI backend link - change to production URL when ready)
FASTAPI_ANALYSIS_URL=http://localhost:8000

# Internal Service-to-Service Secret Token (FastAPI Authentication)
INTERNAL_SERVICE_TOKEN=myguard-internal-secret-token-2026

# JWT Authentication Secret Key
JWT_SECRET=myguard-production-secret-change-this
